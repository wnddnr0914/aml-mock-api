{
  "openapi": "3.1.0",
  "info": {
    "title": "GNN Inference Mock API",
    "description": "GNN 개발 동안 추론 인터페이스만 대체합니다. 거래 ID를 보내면 고정 점수를 즉시 반환합니다. 원본 그래프 조회·추출, 패턴 분석, GNNExplainer, 보고서 생성은 별도 모듈의 책임입니다. API_KEY 설정 시 Authorize에 키 값만 입력하세요.",
    "version": "2.0.0"
  },
  "paths": {
    "/api/v1/detect": {
      "post": {
        "tags": [
          "GNN"
        ],
        "summary": "거래 ID별 GNN Mock 점수 반환",
        "operationId": "detect_api_v1_detect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectRequest"
              },
              "examples": {
                "golden": {
                  "summary": "골든 케이스 4거래",
                  "value": {
                    "tx_ids": [
                      "TX_99198",
                      "TX_99199",
                      "TX_99200",
                      "TX_99201"
                    ],
                    "threshold": 0.8
                  }
                },
                "selected": {
                  "summary": "선택 거래 1건",
                  "value": {
                    "tx_ids": [
                      "TX_99201"
                    ],
                    "threshold": 0.8
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DetectRequest": {
        "properties": {
          "tx_ids": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Tx Ids",
            "description": "서버에 준비된 거래의 ID. 입력 순서대로 점수를 반환합니다."
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "description": "anomaly_score >= threshold이면 is_detected=true",
            "default": 0.8
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tx_ids"
        ],
        "title": "DetectRequest"
      },
      "DetectResponse": {
        "properties": {
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock",
            "default": true
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/Prediction"
            },
            "type": "array",
            "title": "Predictions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_version",
          "threshold",
          "predictions"
        ],
        "title": "DetectResponse"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "unknown_tx_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unknown Tx Ids"
          },
          "details": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Prediction": {
        "properties": {
          "tx_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Tx Id"
          },
          "anomaly_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Anomaly Score",
            "description": "연동용 고정 의심 점수. 보정된 범죄 확률이 아닙니다."
          },
          "is_detected": {
            "type": "boolean",
            "title": "Is Detected",
            "description": "모델 점수에 임계값을 적용한 후처리 결과"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tx_id",
          "anomaly_score",
          "is_detected"
        ],
        "title": "Prediction"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
